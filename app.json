{
  "expo": {
    "name": "GLP-1 Coach",
    "slug": "glp1-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glp1coach.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "GLP-1 Coach reads your step count to display daily activity and help you track your fitness progress.",
        "NSHealthUpdateUsageDescription": "GLP-1 Coach does not write health data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.glp1coach.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to analyze meal content.",
          "cameraPermission": "The app accesses your camera to capture meal photos."
        }
      ],
      "expo-localization"
    ],
    "scheme": "glp1coach",
    "extra": {
      "eas": {
        "projectId": "b328678b-4d82-4468-9028-6890cf5aad20"
      }
    },
    "owner": "guvenser"
  }
}
