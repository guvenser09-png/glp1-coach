# GLP-1 Coach — environment variables
# Copy this file to ".env" and fill in your keys, then restart `npx expo start`.
# Expo loads .env into process.env for app.config.js (SDK 49+).

# Required for AI meal analysis, AI coach chat, AI notifications & AI diet plans.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — only needed if you re-enable the paywall / subscriptions (RevenueCat).
REVENUECAT_API_KEY=
