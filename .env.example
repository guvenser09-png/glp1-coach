# GLP-1 Coach — environment variables
# Copy this file to ".env" and fill in the values, then restart `npx expo start`.
# Expo loads .env into process.env for app.config.js (SDK 49+).

# ── Supabase (required) ───────────────────────────────────────────────────────
# The app's backend: Auth + Postgres + Edge Functions. The anon/publishable key
# is safe to ship in the client (public by design). The service_role key must
# NEVER be placed here or in any client file — it belongs only in Supabase
# Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── OpenAI (server-side only — DO NOT put it here) ────────────────────────────
# AI (meal photo analysis, coach chat, notifications, diet plans) runs through the
# Supabase Edge Function `ai-proxy`, which holds the OpenAI key server-side. Set it
# in the Supabase dashboard: Project Settings -> Edge Functions -> Secrets:
#   OPENAI_API_KEY=sk-...
# There is NO client-side OpenAI key.

# ── Optional ──────────────────────────────────────────────────────────────────
# Only needed if you re-enable the paywall / subscriptions (RevenueCat).
REVENUECAT_API_KEY=
